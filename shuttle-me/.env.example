# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) or the legacy service_role key — server only, never NEXT_PUBLIC
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Web Push (run `pnpm vapid` once and paste) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- App secrets ---
# Random 32+ chars. Used to derive the Supabase Auth password from a student's PIN.
# Changing it logs everyone out and invalidates every PIN.
PIN_PEPPER=
# Random 32+ chars. pg_cron / cron-job.org must send `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Public URL of the deployed app (used in push payloads and the install guide)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: map tile provider (default Esri World Street Map, no key). A custom host is network-only unless added to public/sw.js.
# NEXT_PUBLIC_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=Tiles &copy; Esri

# --- Local SQL tests only ---
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/kharis_test
