# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) or the legacy service_role key — server only, never NEXT_PUBLIC
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Web Push (run `pnpm vapid` once and paste) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- App secrets ---
# Random 32+ chars. Used to derive the Supabase Auth password from a student's PIN.
# Changing it logs everyone out and invalidates every PIN.
PIN_PEPPER=
# Random 32+ chars. pg_cron / cron-job.org must send `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Public URL of the deployed app (used in push payloads and the install guide)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Map basemap ---
# Vector basemap (default): a MapLibre style rendered inside the Leaflet maps. OpenFreeMap "bright"
# shows the real names of places around campus (halls, hostels, churches, shops, roads), needs no key.
# Any MapLibre style URL works (e.g. MapTiler streets-v2 with a key, or a self-hosted style); a host other
# than tiles.openfreemap.org is network-only unless added to public/sw.js. Set to "" or "off" for raster only.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
# Optional real dark style; without one dark mode is the CSS filter on the map canvas.
# NEXT_PUBLIC_MAP_STYLE_URL_DARK=
# NEXT_PUBLIC_MAP_STYLE_ATTRIBUTION=<a href="https://openfreemap.org">OpenFreeMap</a> &copy; <a href="https://www.openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Raster tiles (fallback when WebGL is unavailable or the style is off; default Esri World Street Map, no key, dark mode = CSS filter) ---
# Production uses CARTO with the hostel's basemap key (set the same values in Vercel; never commit the key).
# {r} is Leaflet's retina placeholder ("@2x" on 2x screens). A custom host is network-only unless added to public/sw.js.
# NEXT_PUBLIC_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=YOUR_CARTO_KEY
# With a dark URL both maps swap the tile layer on prefers-color-scheme instead of filtering the light tiles.
# NEXT_PUBLIC_MAP_TILE_URL_DARK=https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png?key=YOUR_CARTO_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>
# Deepest zoom the provider serves (default 18 when the light URL's host ends with cartocdn.com — z19+ is 403 — else 19).
# NEXT_PUBLIC_MAP_TILE_MAX_NATIVE_ZOOM=18

# --- Road routing (optional; server only) ---
# OSRM-compatible router for the live map's road route and road-snapped trail. Default: the public
# demo server (rate-limited, best-effort — answers are cached in memory, time-boxed to 6 s and the
# map falls back to straight lines when it is unavailable). Point it at your own OSRM to be sure.
# ROUTER_BASE_URL=https://router.project-osrm.org
# Coordinates per map-matching request: the public demo allows 10; a self-hosted OSRM allows 100.
# ROUTER_MATCH_CHUNK_POINTS=10

# --- Local SQL tests only ---
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/kharis_test
